{% extends  partials/_html_wrapper.nimja %}

{% block extra-head %}
  <link href="https://static.davicompai.com/reset.css" rel="stylesheet">
  <link href="https://static.davicompai.com/ifBrutal.css" rel="stylesheet">
  <link href="/articles/style.css" rel="stylesheet">
{% endblock %}


{% block header %}
  <h1>DaviCompai's <wbr>Blog</h1>
{% endblock %}


{% block content %}

  {% for row in db.iterate("SELECT title,content_pure,slug FROM posts ORDER BY date_made desc;") %}

  <a href="{{row[2].strVal}}">
    <article>
      <div>
        <h2>{{row[0].strVal}}</h2>
        <p>{{row[1].strVal}}</p>
      </div>
      <img src="https://images.unsplash.com/photo-1791444644675-94fbc1ba1439?q=80&w=687&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D" alt="descrição da imagem">
    </article>
  </a>
    
  
  {% endfor %}

{% endblock %}


{% block footer %}
  {% importnimja partials/_default_footer.nimja %}
  <!-- <script type="module" src="https://static.davicompai.com/librarys/htmx.js" crossorigin="anonymous"></script> -->
{% endblock %}

