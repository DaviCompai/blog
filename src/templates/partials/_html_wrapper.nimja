<!DOCTYPE html>
<html lang="{{ (if language != "": language else: "pt-br") }}">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    {%block extra-head %}{%endblock%}
  </head>
  <body>

    <header>
      {% block header %}{% endblock %}
    </header>

    <main>
      {% block content %}{% endblock %}
    </main>

    <footer>
      {% block footer%}{% endblock %}
    </footer>
  
  </body>
</html>
